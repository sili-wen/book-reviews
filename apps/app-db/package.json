{
  "name": "db",
  "version": "1.0.0",
  "description": "Database schema and migrations using DrizzleORM",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "drizzle-kit generate:pg",
    "migrate": "node -r ts-node/register db/migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.29.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.20.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
} 